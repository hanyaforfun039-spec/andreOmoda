---
/* Daftar model. Tab hanya muncul kalau modelnya lebih dari satu, sehingga
   halaman tetap rapi sekarang dan otomatis berguna saat mobil bertambah. */
import { getAllCars } from '../lib/cars';
import CarCard from './CarCard.astro';
const cars = getAllCars();
---
<section class="lineup" id="lineup">
  <div class="wrap">
    <h1 class="sec-title">OMODA Lineup</h1>

    {cars.length > 1 && (
      <div class="lineup__tabs" role="tablist">
        {cars.map((c, i) => (
          <a class="lineup__tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} href={`/mobil/${c.slug}`}>
            {c.namaPendek}
          </a>
        ))}
      </div>
    )}
    <div class="lineup__rule"></div>

    {cars.map((c) => <CarCard car={c} />)}
  </div>
</section>
