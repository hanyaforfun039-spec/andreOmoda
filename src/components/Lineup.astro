---
/* Daftar model di beranda. Deret nama di atas berfungsi sebagai pintasan ke
   tiap halaman model; ia hanya muncul kalau modelnya lebih dari satu. */
import { getAllCars } from '../lib/cars';
import CarCard from './CarCard.astro';
const cars = getAllCars();
---
<section class="lineup" id="lineup">
  <div class="wrap">
    <h1 class="sec-title">OMODA Lineup</h1>

    {cars.length > 1 && (
      /* Tautan biasa, bukan role="tablist": tombol ini berpindah halaman,
         bukan menukar panel, sehingga peran tab justru menyesatkan pembaca
         layar. */
      <nav class="lineup__tabs" aria-label="Pintasan model">
        {cars.map((c) => (
          <a class="lineup__tab" href={`/mobil/${c.slug}`}>{c.namaPendek}</a>
        ))}
      </nav>
    )}
    <div class="lineup__rule"></div>

    <div class="lineup__daftar">
      {cars.map((c) => <CarCard car={c} />)}
    </div>
  </div>
</section>
